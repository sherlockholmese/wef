.load wef.dll
g
!wef
!wef.install
ctx
!wef.ctx -regs
!wef.context -regs
!wef.ctx auto status
!wef.registers
telescope @rsp L8
!wef.dereference @rsp L8
hexdump @rsp L80
!wef.search_pattern hex:4141 @rsp L100 -max 1
!wef.search_pattern "str:AA BB" @rsp L100 -max 1
!wef.pattern create 32
!wef.pattern search Aa3 L256
!wef.pattern offset Aa3 L256
!wef.vmmap -contains @rsp L4
!wef.xinfo @rsp
!wef.xfiles
!wef.xfiles wef_fixture .data
!wef.arch get
!wef.arch list
!wef.eval @rsp @rip
!wef.process_status
r @$t2 = @rip
r @$t3 = @efl
r efl = @efl | 0x40
r rip = wef_fixture!wef_branch_target
!wef.ctx -code L2
r rip = @$t2
r efl = @$t3
!wef.aliases
!wef.patch qword wef_fixture!wef_patch_target 0xaabbccddeeff0011
dq wef_fixture!wef_patch_target L1
!wef.nop wef_fixture!wef_nop_target L4
db wef_fixture!wef_nop_target L8
r @$t0 = @rip
!wef.skipi --n 1
r rip = @$t0
r @$t1 = @efl
!wef.edit_flags +CF
r efl = @$t1
!wef.entry_break
!wef.name_break smoke-break wef_fixture!wef_nop_target
!wef.name_break list
!wef.name_break delete smoke-break
!wef.stepover help
!wef.heaps help
!wef.ttd help
!wef.uninstall
!wef.ctx
q
